# ==========================================
# Backend Environment Variables
# ==========================================

PORT=5000
NODE_ENV=production

# MongoDB Connection String (e.g., MongoDB Atlas in production)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/carbon_footprint?retryWrites=true&w=majority

# Secret key for JWT signing
JWT_SECRET=your_jwt_secret_key_here

# Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Email SMTP credentials for 2FA / Registration OTP emails
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password

# Optional: Google OAuth Client ID for verifying Google tokens
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
