# ==========================================
# Frontend Environment Variables
# ==========================================

# URL of your deployed backend API (or http://localhost:5000/api for local development)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Optional: Google OAuth 2.0 Client ID (from Google Cloud Console)
# If left unset or blank, simulated Google Auth is automatically used without errors.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
